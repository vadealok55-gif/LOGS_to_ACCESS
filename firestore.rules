rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth helper
    function isAuthenticated() {
      return request.auth != null;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Organization Member Rules
    match /org_members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Refine further as needed
    }

    // Organization Rules
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Refine further as needed
    }

    // Global Catch-all (Temporary but restricted to Auth)
    match /{document=**} {
      allow read, write: if isAuthenticated() && request.time < timestamp.date(2026, 6, 1);
    }
  }
}

