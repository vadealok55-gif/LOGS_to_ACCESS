# ========================================
#  NexusGuard Project - .gitignore
# ========================================

# --- Dependencies ---
node_modules/
package-lock.json

# --- Environment & Credentials ---
.env
.env.*
.env.local
.env.development
.env.production
*.env

# --- Firebase Service Account Key (CRITICAL) ---
serviceAccountKey.json
*serviceAccount*.json
*-firebase-adminsdk-*.json

# --- Firebase ---
.firebaserc
firebase-debug.log
firebase-debug.*.log
.firebase/

# --- Build Output ---
dist/
dist-ssr/
build/

# --- Logs & Debug Output ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
verify_out.txt
err.txt
lint.txt
lint_out.txt
lint_out.json
eslint_output.txt
l.json

# --- Editor & IDE ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# --- OS Files ---
*.local
desktop.ini

# --- Temporary & Test Files ---
*.tmp
*.temp
